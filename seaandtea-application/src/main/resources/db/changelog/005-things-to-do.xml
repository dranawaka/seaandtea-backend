        </createTable>
        <addForeignKeyConstraint baseTableName="event_sources" baseColumnNames="event_id" constraintName="fk_event_sources" referencedTableName="events" referencedColumnNames="id"/>

        <createTable tableName="event_images">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="event_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="url" type="VARCHAR(1000)"><constraints nullable="false"/></column>
            <column name="alt_text" type="VARCHAR(300)"/>
