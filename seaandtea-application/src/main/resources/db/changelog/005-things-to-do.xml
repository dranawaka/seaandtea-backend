            <column name="event_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="tradition" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="recurrence_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="poya_name" type="VARCHAR(40)"/>
